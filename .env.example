# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PULPERIA_ADMIN_KEY: Clave administrativa para el panel de plataforma (por defecto: admin-pulperia-2026 en modo demo)
PULPERIA_ADMIN_KEY="admin-pulperia-2026"

# PULPERIA_DB_PATH: Ruta opcional para el archivo SQLite
PULPERIA_DB_PATH="./data/pulperia.db"

# GITHUB_TOKEN & GITHUB_REPO: Opcional para sincronizar y subir el repositorio a GitHub automáticamente
GITHUB_TOKEN=""
GITHUB_REPO="normanescobar804-cloud/pulperia-nicaragua"
